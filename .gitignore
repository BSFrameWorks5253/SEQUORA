*.py[cod]
*$py.class
*.spec

# Virtual Environments
venv/
.venv/
env/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Legacy electron node_modules
electron/node_modules/

# Secrets & Config
.github_token
*.token
.env
